{
  "openrockVersion": 1,
  "kind": "library",
  "name": "@openrock/localization",
  "version": "1.0.0",
  "entry": "src/register.js",
  "provides": {
    "api": "src/register.js",
    "hookNamespaces": [
      "localization"
    ]
  },
  "scripts": {
    "buildTime": true,
    "external": [
      {
        "name": "prebuild",
        "path": "src/prebuild.js",
        "runs": "build",
        "why": "runs machine-translation providers (may use the network) before a build when autoTranslate is enabled"
      }
    ]
  }
}
